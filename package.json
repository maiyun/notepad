{
  "name": "clickgo-notepad",
  "version": "2.0.0",
  "description": "A lightweight text editor for web and desktop, primarily showcasing the ClickGo framework series.",
  "type": "module",
  "keywords": [
    "notepad"
  ],
  "main": "./dist/index.js",
  "author": {
    "name": "MAIYUN.NET",
    "email": "maiyun.net@gmail.com"
  },
  "desktopName": "net.maiyun.clickgo-notepad.desktop",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc && clickgo --app ./dist/app",
    "check": "tsc --noEmit --pretty false",
    "sass": "sass --watch dist/:dist/ --style compressed --no-source-map"
  },
  "build": {
    "appId": "net.maiyun.clickgo-notepad",
    "productName": "ClickGo Notepad",
    "publish": {
      "provider": "github",
      "owner": "maiyun",
      "repo": "notepad",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "./doc/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "rpm", "arch": ["x64", "arm64"] }
      ],
      "icon": "./doc/logo.png",
      "category": "Utility",
      "syncDesktopName": true
    },
    "files": [
      "dist/**/*",
      "!dist/app/**/*",
      "!dist/*.ts",
      "!dist/*.scss"
    ],
    "directories": {
      "output": "build"
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "clickgo": "^6.1.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "clickgo-native": "^2.0.4",
    "electron-updater": "^6.8.9"
  }
}
